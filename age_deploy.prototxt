
            name: "Age Net"
            input: "data"
            input_dim: 1
            input_dim: 3
            input_dim: 227
            input_dim: 227
            
            layer { name: "conv1" type: "Convolution" bottom: "data" top: "conv1"
              convolution_param { num_output: 96 kernel_size: 7 stride: 4
                weight_filler { type: "gaussian" std: 0.01 }
                bias_filler { type: "constant" value: 0 } } }
            